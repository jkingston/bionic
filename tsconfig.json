{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["lib/**/*.ts", "extensions/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"]
}
