{
  "extensions": [
    "../../dist/extensions/clock.js",
    "../../dist/extensions/catalog.js",
    "./platform.mjs"
  ],
  "requiredProviders": ["bionic.clock", "bionic.catalog", "example.platform"],
  "grant": {
    "principal": "example-deployment",
    "readPrefixes": [""],
    "writePrefixes": [""],
    "tools": [
      "read",
      "write",
      "edit",
      "ls",
      "find",
      "grep",
      "search",
      "verify",
      "execute",
      "capabilities"
    ],
    "capabilities": [
      "work.current",
      "policy.describe",
      "clock.now",
      "catalog.list",
      "catalog.get",
      "platform.health"
    ],
    "services": [],
    "resources": {
      "bionic.catalog": { "entries": ["checkout", "payments"] },
      "example.platform": { "services": ["checkout"] }
    },
    "limits": {
      "calls": 200,
      "writes": 30,
      "sourceBytes": 1048576,
      "outputBytes": 2097152,
      "workMs": 120000,
      "runMs": 10000,
      "depth": 8,
      "workers": 12
    }
  }
}
